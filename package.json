{
  "name": "docconverter",
  "productName": "DocConverter",
  "version": "2.0.1",
  "description": "kordoc 기반 한국 문서 변환 도구",
  "author": "Backaura",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node test/integration.mjs",
    "engine": "npm ci --prefix engine --no-audit --no-fund && node scripts/prepare-engine.cjs",
    "dist": "npm run engine && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "npm": "12.2.0",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.backaura.docconverter",
    "productName": "DocConverter",
    "artifactName": "DocConverter-Setup-${version}.exe",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json", "README.md"],
    "electronLanguages": ["ko", "en-US"],
    "asarUnpack": ["src/main/compare.mjs", "src/main/node-shim.cjs"],
    "extraResources": [
      { "from": "engine/node_modules", "to": "engine/node_modules" },
      { "from": "node_modules/npm", "to": "npm" },
      { "from": "node_modules/npm/node_modules", "to": "npm/node_modules" },
      { "from": "resources/smoke", "to": "smoke" },
      { "from": "vcruntime", "to": "vcruntime" }
    ],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DocConverter"
    }
  }
}
